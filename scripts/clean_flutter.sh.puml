@startuml
title Flutter Project Setup Script

footer
© 2026 Mirko THULKE — All rights reserved
See LICENSE file in the project root for details.
end footer

start

:Resolve script directory;
:Set PROJECT_ROOT;
:Change directory to PROJECT_ROOT;

:Print project root;

if (Running inside Docker?) then (yes)
  :Set GRADLE_USER_HOME to PROJECT_ROOT/.gradle;
else (no)
  :Set GRADLE_USER_HOME to HOME/.gradle;
endif

:Print Gradle cache location;

:Regenerate android/local.properties;
:Run generate_local_properties.sh;

:Check pubspec.yaml for integration_test;

if (integration_test present?) then (yes)
  :Print "integration_test already present";
else (no)

  if (dev_dependencies exists?) then (yes)
    :Insert integration_test into dev_dependencies;
  else (no)
    :Append dev_dependencies section;
    :Add integration_test;
  endif

endif

:Run flutter clean;

:Run flutter pub get;

:Print "Clean and setup complete";

stop
@enduml