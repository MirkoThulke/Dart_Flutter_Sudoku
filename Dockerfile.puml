@startuml

skinparam componentStyle rectangle
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 80

top to bottom direction

legend top
Immutable Toolchain Versions

Java              : 17
Flutter           : 3.35.7
Rust              : 1.91.1
Android SDK Tools : 13114758
Android Compile   : 36
Android BuildTools: 35.0.0
NDK               : 28.2.13676358
CMake             : 3.22.1
Base Image        : ubuntu 22.04
endlegend


' ============================================================
' MULTI-STAGE BUILD MODEL
' ============================================================

package "Docker Multi-Stage Build" {

  component env
  note right of env
    Defines:
    - All ENV variables
    - Tool versions
    - Paths
  end note

  component base
  note right of base
    Adds:
    - System packages
    - OpenJDK 17
    - 32-bit libraries
    - build-essential
  end note

  component android
  note right of android
    Installs:
    - Android cmdline tools
    - platform-tools
    - SDK 36
    - Build Tools 35.0.0
    - NDK 28.2.13676358
    - CMake 3.22.1
  end note

  component flutter
  note right of flutter
    Installs:
    - Flutter 3.35.7
    - flutter precache --android
    - Locks SDK read-only
  end note

  component rust
  note right of rust
    Installs:
    - Rust 1.91.1
    - Android targets
    - cargo-ndk
  end note

  component chrome
  note right of chrome
    Installs:
    - google-chrome-stable
    - Headless flags
  end note

  component final
  note right of final
    Assembles:
    - Android SDK (read-only)
    - Flutter SDK (read-only)
    - Rust toolchain
    - Chrome
    - Runs as UID 2000
  end note

}

env --> base
base --> android
android --> flutter
base --> rust
base --> chrome
flutter --> final
android --> final
rust --> final
chrome --> final


' ============================================================
' SECURITY MODEL
' ============================================================

package "Security Model" {

  component "Immutable Toolchain Layer\n(Inside Image)" as TOOLCHAIN
  note right of TOOLCHAIN
    /opt/flutter
    /opt/android/sdk
    /opt/rust
    /usr/lib/jvm

    Installed at build time
    Owned by root
    Read-only in CI
    Fully reproducible
  end note

  component "Persistent Host Cache\n(Mounted Volume)" as CACHE
  note right of CACHE
    /home/jenkins_host_cache

    .pub-cache
    .gradle
    .cargo

    Writable
    UID 2000
    Speeds up builds
    No SDK content
  end note

  component "Ephemeral Workspace\n(Mounted)" as WORKSPACE
  note right of WORKSPACE
    CONTAINER_WORKSPACE

    git checkout
    build outputs
    android/build
    .dart_tool

    Writable
    Clean per build
    No toolchain
  end note
}

TOOLCHAIN --> WORKSPACE
CACHE --> WORKSPACE


' ============================================================
' REPRODUCIBILITY MODEL
' ============================================================

package "Reproducibility Model" {

  component "Pinned Versions" as PINNED
  note right of PINNED
    ENV-based version locking:
    - FLUTTER_VERSION
    - RUST_VERSION
    - BUILD_TOOLS
    - NDK_MAIN
    - COMPILE_SDK
  end note

  component "Immutable SDK Lock" as SDKLOCK
  note right of SDKLOCK
    chmod -R a=rX
    SDK never modified at runtime
  end note

  component "Non-root Runtime" as NONROOT
  note right of NONROOT
    USER 2000
    Prevents SDK mutation
  end note

}

PINNED --> SDKLOCK
SDKLOCK --> NONROOT

@enduml