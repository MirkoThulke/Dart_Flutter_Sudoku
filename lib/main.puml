See LICENSE file in the project root for details.
end footer

skinparam classAttributeIconSize 0
skinparam shadowing false

package "Application Entry" {

class main {
+main() : void
}

class runApp {
+runApp(widget)
}

}

package "Provider Framework" {

class MultiProvider {
+providers : List<Provider>
+child : Widget
}

class ChangeNotifierProvider {
+create()
}

class ChangeNotifier

}

package "State Management" {

class DataProvider {
+notifyListeners()
+gameState
}

class SizeConfig {
+init(context)
+orientation
+screenWidth
}

}

package "Application Root Widget" {

class MyApp {
+build(context)
}

class StatelessWidget
MyApp --|> StatelessWidget

}

package "Flutter Core" {

class Widget

}

'------------------------------------------------
' Bootstrapping relationships
'------------------------------------------------

main --> runApp : calls

runApp --> MultiProvider : root widget

MultiProvider --> ChangeNotifierProvider : contains

ChangeNotifierProvider --> DataProvider : provides
ChangeNotifierProvider --> SizeConfig : provides

MultiProvider --> MyApp : child

DataProvider --|> ChangeNotifier
SizeConfig --|> ChangeNotifier

MyApp --> Widget

@enduml
