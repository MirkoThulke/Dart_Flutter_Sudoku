@startuml

title Flutter DataProvider – State Management & Rust FFI Bridge
left to right direction

skinparam classAttributeIconSize 0
skinparam shadowing false

' =========================================================
' FLUTTER UI
' =========================================================

class FlutterUI <<actor>>

package "Flutter Widgets" {
  class SudokuGrid
  class NumberButtons
  class PatternButtons
  class ActionButtons
}

FlutterUI --> SudokuGrid
FlutterUI --> NumberButtons
FlutterUI --> PatternButtons
FlutterUI --> ActionButtons


' =========================================================
' STATE MANAGEMENT
' =========================================================

package "State Management" {

class DataProvider {
  + status : DataStatus
  + errorMessage : String

  + selectedNumberList
  + selectedNumStateList
  + selectedSetResetList
  + selectedPatternList
  + selectedUndoIconList
  + selectedAddRemoveList

  + dartMatrix
  + rustMatrix

  --
  + updateDataNumberlist()
  + updateDataselectedPatternList()
  + updateDataselectedEraseAll()
  + updateDataselectedResetToGivens()
  + updateDataselectedSetAllCandidates()
  + updateDataselectedwriteGivensToRust()

  --
  + callRustUpdate()
  + readMatrixFromRust()
  + writeCellToRust()
  + writeFullMatrixToRust()

  --
  + shutdown()
}

}

SudokuGrid --> DataProvider
NumberButtons --> DataProvider
PatternButtons --> DataProvider
ActionButtons --> DataProvider


' =========================================================
' MATRIX DATA MODEL
' =========================================================

package "Matrix Data" {

class DartToRustElement
class DartMatrix

}

DartMatrix --> DartToRustElement
DataProvider --> DartMatrix


' =========================================================
' RUST FFI LAYER
' =========================================================

package "Rust FFI Bridge" {

class RustMatrix {
  + update()
  + erase()
  + setAllCandidates()
  + updateCell()
  + readMatrixFromRust()
  + writeMatrixToRust()
  + saveToJSON()
  + loadFromJSON()
  + dispose()
}

}

DataProvider --> RustMatrix


' =========================================================
' RUST BACKEND
' =========================================================

package "Rust Solver Engine" {

class SolverMatrix
class PatternDetection
class PersistenceJSON

}

RustMatrix --> SolverMatrix
SolverMatrix --> PatternDetection
SolverMatrix --> PersistenceJSON


' =========================================================
' LOCAL STORAGE
' =========================================================

package "Local Storage" {
  class JSONFile
}

PersistenceJSON --> JSONFile


' =========================================================
' APP LIFECYCLE
' =========================================================

package "Flutter Lifecycle" {

class WidgetsBindingObserver

}

DataProvider --> WidgetsBindingObserver

WidgetsBindingObserver --> DataProvider : paused / detached


note right of DataProvider
Main responsibilities:

• Store UI state
• Handle button interactions
• Synchronize Dart matrix with Rust
• Call Rust solver
• Notify Flutter widgets
• Persist data on shutdown
end note

@enduml