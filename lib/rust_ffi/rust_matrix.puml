' =========================================================
' DART DATA MODEL
' =========================================================

package "Dart Model" {

class DartToRustElement {
  + row : int
  + col : int
  + selectedNum : int
  + selectedNumStateList : List<bool>
  + selectedCandList : List<bool>
  + selectedPatternList : List<bool>
  + requestedElementHighLightType : List<bool>
  + requestedCandHighLightType : List<int>
}

note right of DartToRustElement
Pure Dart representation of a Sudoku cell.
Used for UI and debugging.
end note

}

' =========================================================
' FFI STRUCT
' =========================================================

package "FFI Struct Mapping" {

class DartToRustElementFFI <<Struct>> {
  + row : u8
  + col : u8
  + selectedNum : u8
  + selectedNumStateList[2]
  + selectedCandList[9]
  + selectedPatternList[4]
  + requestedElementHighLightType[5]
  + requestedCandHighLightType[9]
}

note right of DartToRustElementFFI
Memory layout must match
Rust struct exactly.
end note

}

DartToRustElement --> DartToRustElementFFI : copied to / from


' =========================================================
' MATRIX WRAPPER
' =========================================================

package "RustMatrix Wrapper" {

class RustMatrix {
  + ptr : Pointer<DartToRustElementFFI>
  + numRows : int
  + numCols : int

  + update()
  + erase(bool)
  + setAllCandidates()
  + updateCell(row,col)
  + writeCellToRust(...)
  + writeMatrixToRust(...)
  + writeGivensToRust(...)
  + readCellFromRust(...)
  + readMatrixFromRust(...)
  + saveToJSON()
  + loadFromJSON()
  + dispose()
}

}

RustMatrix --> DartToRustElementFFI : owns pointer


' =========================================================
' FFI FUNCTION BINDINGS
' =========================================================

package "Rust FFI Functions" {

class create_matrix
class update_matrix
class erase_matrix
class set_all_candidates
class update_cell
class save_data
class load_data
class free_matrix

}

RustMatrix --> create_matrix
RustMatrix --> update_matrix
RustMatrix --> erase_matrix
RustMatrix --> set_all_candidates
RustMatrix --> update_cell
RustMatrix --> save_data
RustMatrix --> load_data
RustMatrix --> free_matrix


' =========================================================
' MEMORY MANAGEMENT
' =========================================================

package "Memory Lifecycle" {

class _MatrixHandle {
  + ptr
  + rows
  + cols
}

class Finalizer

}

RustMatrix --> _MatrixHandle
Finalizer --> _MatrixHandle
Finalizer --> free_matrix


note right of Finalizer
When Dart GC collects RustMatrix,
Finalizer automatically calls
free_matrix(ptr).
end note


' =========================================================
' DATA FLOW
' =========================================================

package "Matrix Data Flow" {

class DartMatrix
class RustMatrixMemory

}

DartMatrix --> RustMatrix : writeMatrixToRust()
RustMatrixMemory --> DartMatrix : readMatrixFromRust()

RustMatrix --> RustMatrixMemory


' =========================================================
' FILE PERSISTENCE
' =========================================================

package "Persistence Layer" {

class JSONFile
class saveToJSON
class loadFromJSON

}

RustMatrix --> saveToJSON
RustMatrix --> loadFromJSON

saveToJSON --> JSONFile
loadFromJSON --> JSONFile


' =========================================================
' FLUTTER APP
' =========================================================

class FlutterApp <<actor>>

FlutterApp --> RustMatrix : create / update
FlutterApp --> DartMatrix

@enduml