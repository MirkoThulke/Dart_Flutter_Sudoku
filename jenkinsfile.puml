@startuml Jenkins_Pipeline_With_Architecture
title Jenkins CI Pipeline - Flutter + Rust + Android

start

:Workspace Sanity Clean;
note right
cleanWs()
Ensures fully fresh ephemeral workspace.
end note

:Define Project Paths;
note right
Sets:
FLUTTER_CONTAINER_WORKSPACE = $WORKSPACE
FLUTTER_CONTAINER_CACHE = /jenkins_container_cache
REPO_CHECKOUT_DIR = workspace/git_checkout
Separates workspace vs persistent cache.
end note

:Setup Environment;
note right
Creates:
- .gradle
- .pub-cache
- .home
- artifacts/
Validates:
- Cache writable
- SDK read-only
end note

:CI Self-Test;
note right
Fail-fast validation:
✔ Required ENV variables exist
✔ Workspace & cache mounted
✔ Toolchains available
✔ Flutter SDK NOT writable
end note

partition "Source Control" {

    :Checkout in Container;
    note right
    git clone → git_checkout/
    git reset to branch
    Gradle wrapper executable
    end note

    :Validate Repo Structure;
    note right
    Requires:
    - pubspec.yaml
    - android/
    - scripts/
    end note

    :Verify Rust Source;
    note right
    Ensures rust/rust_lib exists.
    end note
}

partition "Static Analysis (Optional)" {

    if (RUN_FAST_STATIC?) then (yes)
        :Flutter + Rust FAST;
        note right
        flutter analyze
        dart format
        cargo check
        end note
    endif

    if (RUN_HEAVY_STATIC?) then (yes)
        :Android + Rust HEAVY;
        note right
        ./gradlew lint
        cargo clippy
        cargo audit
        end note
    endif
}

partition "Cleaning Strategy" {

    :Light Clean;
    note right
    Removes:
    - build/
    - android/build/
    - .dart_tool
    Keeps persistent caches intact.
    end note

    if (DEEP_CLEAN?) then (yes)
        :Deep Clean;
        note right
        Also removes:
        - Gradle module caches
        - Pub hosted/git
        - Rust artifacts
        - JNI libs
        end note
    endif
}

partition "Build Graph" {

    :Build Rust (FFI);
    note right
    cargo ndk build --release
    Produces JNI .so libraries
    into android/app/src/main/jniLibs
    end note

    if (RUN_MATERIALIZATION_STAGE?) then (yes)
        :Flutter pub get;
        :flutter build apk --debug;
        note right
        Validates Flutter ↔ Gradle
        integration and engine artifacts.
        end note
    endif
}

partition "Release Build" {

    if (BUILD_MODE == release?) then (yes)

        :Inject Android Signing;
        note right
        Uses Jenkins credentials:
        - KEYSTORE_FILE
        - KEYSTORE_PASSWORD
        - KEY_PASSWORD
        - KEY_ALIAS
        Generates key.properties
        end note

        :Build Release APK;
        :Build Release AAB;

        note right
        flutter build apk --release
        flutter build appbundle --release
        Copies output to artifacts/
        end note

    else (debug)

        :Build Debug APK;

    endif
}

partition "Validation & Extras" {

    if (RUN_INTEGRATION_TESTS?) then (yes)
        :Run Integration Tests;
    endif

    if (RUN_ABB_RELEASE_TEST?) then (yes)
        :Validate AAB;
        note right
        Uses bundletool:
        ✔ Validate structure
        ✔ Verify signature
        ✔ Dump versionCode/versionName
        end note
    endif

    if (RUN_PLANTUML_DOCU_BUILD?) then (yes)
        :Generate Diagrams;
    endif
}

:Archive Artifacts;
note right
archiveArtifacts artifacts/**
Stored under:
Jenkins build archive
end note

:Post Section;
note right
✔ Remove key.properties
✔ cleanWs(deleteDirs=true)
✔ Print build result
end note

stop
@enduml