@startuml
title Sudoku Data Persistence (store_data.rs)

skinparam classAttributeIconSize 0
skinparam shadowing false

' =========================================================
' FFI DATA STRUCTURE
' =========================================================

package "FFI Memory Model" {

class DartToRustElementFFI {
  + row : u8
  + col : u8
  + selectedNum : u8
  + selectedNumStateList[2]
  + selectedCandList[9]
  + selectedPatternList[4]
  + requestedElementHighLightType[5]
  + requestedCandHighLightType[9]
}

note right of DartToRustElementFFI
Raw struct used by Dart ↔ Rust FFI.

Uses fixed-size arrays to ensure
predictable memory layout.
end note

}

' =========================================================
' SERIALIZABLE DATA MODEL
' =========================================================

package "JSON Data Model" {

class SerializableElement {
  + row : u8
  + col : u8
  + selectedNum : u8
  + selectedNumStateList : Vec_u8
  + selectedCandList : Vec_u8
  + selectedPatternList : Vec_u8
  + requestedElementHighLightType : Vec_u8
  + requestedCandHighLightType : Vec_u8
}

class AppData {
  + rows : u8
  + cols : u8
  + elements : Vec_SerializableElement
}

note right of SerializableElement
JSON-friendly version of the Sudoku cell.

Rust Vec<u8> arrays are used
instead of fixed-size arrays.
end note

}

SerializableElement --> DartToRustElementFFI : conversion
DartToRustElementFFI --> SerializableElement : conversion

AppData --> SerializableElement : contains


' =========================================================
' CONVERSION LAYER
' =========================================================

package "Conversion Layer" {

class FromFFI {
  + convert_from_ffi()
}

class ToFFI {
  + convert_to_ffi()
}

}

FromFFI --> SerializableElement
FromFFI --> DartToRustElementFFI

ToFFI --> SerializableElement
ToFFI --> DartToRustElementFFI


' =========================================================
' FILE STORAGE API
' =========================================================

package "FFI Persistence API" {

class save_data {
  + save_data(ptr, rows, cols, path)
}

class load_data {
  + load_data(ptr, rows, cols, path)
}

}

save_data --> AppData
load_data --> AppData

save_data --> DartToRustElementFFI
load_data --> DartToRustElementFFI


' =========================================================
' FILE SYSTEM
' =========================================================

package "File System / JSON" {

class serde_json
class filesystem

}

save_data --> serde_json : serialize
save_data --> filesystem : write file

load_data --> filesystem : read file
load_data --> serde_json : deserialize


' =========================================================
' EXTERNAL CALLER
' =========================================================

'component "Flutter / Dart App" as Dart

Dart --> save_data
Dart --> load_data

@enduml