See LICENSE file in the project root for details.
end footer

skinparam classAttributeIconSize 0
skinparam shadowing false

' =========================================================
' CONSTANTS
' =========================================================

package "Constants" {

class MatrixConstants {
  + MAX_UINT : u8 = 255
  + CONST_MATRIX_SIZE : u8 = 9
  + CONST_MATRIX_ELEMENTS : u8 = 81
}

class PatternList {
  + HI_LIGHT_ON : u8
  + PAIRS : u8
  + SINGLES : u8
  + GIVENS : u8
}

class NumStateListIndex {
  + GIVENS : u8
  + FUTUREUSE : u8
}

}

' =========================================================
' ARRAY DEFINITIONS
' =========================================================

package "Default Data Arrays" {

class DefaultLists {
  + constSelectedNumberList[9]
  + constSelectedNumStateList[2]
  + constSelectedPatternList[4]
  + constRequestedElementHighLightType[5]
  + constRequestedCandHighLightType[9]
}

class AllCandidates {
  + constSelectedNumberListAllSelected[9]
}

}

' =========================================================
' FFI DATA STRUCTURE
' =========================================================

package "FFI Data Model" {

class DartToRustElementFFI {
  + row : u8
  + col : u8
  + selectedNum : u8
  + selectedNumStateList[2]
  + selectedCandList[9]
  + selectedPatternList[4]
  + requestedElementHighLightType[5]
  + requestedCandHighLightType[9]
}

note right of DartToRustElementFFI
Represents a single Sudoku cell.

Used for FFI communication
between Dart and Rust.

Total cells = 81
Matrix size = 9 x 9
end note

}

' =========================================================
' MEMORY MODEL
' =========================================================

package "Memory Model" {

class MatrixMemory {
  + allocate()
  + initialize cells
  + contiguous memory block
}

class Allocator {
  + alloc(Layout)
  + dealloc(Layout)
}

MatrixMemory --> DartToRustElementFFI : contains 81
MatrixMemory --> Allocator

}

' =========================================================
' FFI API
' =========================================================

package "C FFI Interface" {

class create_matrix {
  + create_matrix(rows, cols)
}

class update_cell {
  + update_cell(ptr, rows, cols, idx)
}

class erase_matrix {
  + erase_matrix(ptr, rows, cols, erase_givens)
}

class set_all_candidates {
  + set_all_candidates(ptr, rows, cols)
}

class update_matrix {
  + update_matrix(ptr, rows, cols)
}

class free_matrix {
  + free_matrix(ptr, rows, cols)
}

}

create_matrix --> MatrixMemory
free_matrix --> MatrixMemory

update_cell --> DartToRustElementFFI
erase_matrix --> DartToRustElementFFI
set_all_candidates --> DartToRustElementFFI
update_matrix --> DartToRustElementFFI


' =========================================================
' SOLVER / PATTERN ENGINE
' =========================================================

package "Pattern Detection Engine" {

class check_one_element
class check_all_elements

}

update_cell --> check_one_element
update_matrix --> check_all_elements

note right of check_one_element
Detects patterns such as:

- pairs
- singles
- highlight candidates
end note

note right of check_all_elements
Runs solver analysis
over entire matrix
end note

@enduml